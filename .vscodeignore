# 配布する .vsix に入れないもの。
# 実行時に必要なのは out/extension.js とそれが読む out/parser, out/language,
# それに syntaxes/*.tmLanguage.json と language-configuration.json だけ。
.claude/**
.vscode/**
.gitattributes
.gitignore
examples/**
node_modules/**
src/**
tsconfig.json

# ビルド時だけ使うコード（文法の生成側）と、テスト
out/grammar/**
out/tools/**
out/test/**
out/**/*.js.map
